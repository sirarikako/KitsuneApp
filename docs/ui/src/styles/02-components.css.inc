  #kitsune-preview .ks-stat-row .ks-row{font-size:13px}
  #kitsune-preview .ks-stat-row strong{font-weight:500;font-variant-numeric:tabular-nums}
  #kitsune-preview .ks-stat-row small{font-size:12px;color:var(--ks-dim);margin-left:9px;display:inline-block;min-width:36px;text-align:right}
  #kitsune-preview .ks-stat-row .ks-bar-track{height:9px;margin-top:8px}
  #kitsune-preview .ks-plan-visual{display:flex;height:8px;gap:3px;margin-top:12px;border-radius:5px;overflow:hidden;background:var(--ks-soft)}
