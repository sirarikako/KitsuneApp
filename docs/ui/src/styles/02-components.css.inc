  #kitsune-preview .ks-calc-sheet .ks-amount-input{font-size:27px!important;margin:3px 0 12px;white-space:nowrap;overflow-x:auto}
  #kitsune-preview .ks-calc-sheet .ks-calculator{gap:var(--ks-space-2)}

  #kitsune-preview .ks-key.ks-zero{grid-column:span 2}
  #kitsune-preview .ks-key.ks-equal{grid-row:span 2;background:var(--ks-action-bg);color:var(--ks-action-text);border-color:var(--ks-action-bg)}
  #kitsune-preview .ks-calc-actions{display:grid;grid-template-columns:1fr 1fr;margin-top:14px;gap:var(--ks-space-2)}

  #kitsune-preview .ks-calc-error{font-size:12px;min-height:20px;margin:8px 0 0;color:var(--ks-danger)}
  #kitsune-preview .ks-delete-btn{display:flex;align-items:center;justify-content:center;gap:7px;color:var(--ks-danger);width:100%;min-height:var(--ks-control-height);border:var(--ks-card-border);border-radius:var(--ks-control-radius);background:var(--ks-card-surface);padding:var(--ks-space-2) var(--ks-space-4);font-size:var(--ks-font-body)}
  #kitsune-preview .ks-delete-btn svg{width:var(--ks-icon-size);height:var(--ks-icon-size)}
  #kitsune-preview .ks-danger-confirm{background:var(--ks-danger);color:var(--ks-on-danger,light-dark(#fff8f7,#451714))}
  #kitsune-preview :is(.ks-delete-overlay,.ks-wallet-overlay,.ks-period-overlay){align-items:center;padding:18px}
  #kitsune-preview .ks-delete-sheet{background:var(--ks-card-surface);border:var(--ks-card-border);width:100%;border-radius:var(--ks-dialog-radius);padding:var(--ks-space-4);box-shadow:var(--ks-dialog-shadow);max-height:calc(100% - 24px);overflow:auto}
  #kitsune-preview .ks-delete-sheet h3{font-size:18px;font-weight:600;margin:0 0 var(--ks-space-2)}
  #kitsune-preview .ks-delete-summary{font-size:14px;line-height:1.7;margin:0 0 12px;white-space:pre-line}
  #kitsune-preview .ks-delete-sheet .ks-note{margin:0 0 18px}
  #kitsune-preview .ks-entry-detail{padding-top:10px}
  #kitsune-preview .ks-detail-amount{text-align:center;border:var(--ks-card-border);border-radius:var(--ks-radius);padding:var(--ks-space-4);margin-bottom:var(--ks-space-4);background:var(--ks-card-surface)}
  #kitsune-preview .ks-detail-list{border:var(--ks-card-border);border-radius:var(--ks-radius);background:var(--ks-card-surface);padding:0 var(--ks-space-4);margin:0 0 var(--ks-space-4)}
  #kitsune-preview .ks-detail-list>div{display:flex;justify-content:space-between;border-bottom:1px solid var(--ks-line);gap:var(--ks-space-3);padding:var(--ks-space-3) 0}
  #kitsune-preview .ks-detail-list dt{color:var(--ks-dim);flex-shrink:0;font-size:var(--ks-font-body)}
  #kitsune-preview .ks-detail-list dd{margin:0;text-align:right;font-size:var(--ks-font-body);min-width:0;overflow-wrap:anywhere}
  #kitsune-preview .ks-toolbar{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:0 0 10px}
  #kitsune-preview .ks-toolbar>.ks-control{flex:1;font-size:13px}
  #kitsune-preview .ks-toolbar-action{display:flex;align-items:center;justify-content:center;gap:6px;color:var(--ks-accent);min-height:var(--ks-control-height);padding:var(--ks-space-2) var(--ks-space-3);border:var(--ks-card-border);border-radius:var(--ks-control-radius);background:var(--ks-card-surface);font-size:var(--ks-font-body)}
  #kitsune-preview .ks-toolbar-action svg{flex-shrink:0;width:var(--ks-icon-size);height:var(--ks-icon-size)}
  #kitsune-preview .ks-scope>span{display:flex;align-items:center;gap:6px}
